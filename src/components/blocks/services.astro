---
/**
 * The services grid. Auto-collects every page that declares a `service` block
 * of card metadata (the /na-ples/* pages) and orders them by `service.weight` —
 * the Astro equivalent of the old Hugo `where .Site.RegularPages "Type"`.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Container from '../Container.astro';
import { getAssetImage } from '../../lib/assetImages';

interface Props {
	heading: string;
}

const { heading } = Astro.props;

const services = (await getCollection('pages'))
	.filter((p) => p.data.service && !p.data.service.hidden)
	.sort((a, b) => a.data.service!.weight - b.data.service!.weight)
	.map((p) => ({
		href: `/${p.id}/`,
		...p.data.service!,
		cardImage: getAssetImage(`c-services__${p.data.service!.image}`),
	}));
---

<section id="zaridime" class="py-16">
	<Container>
		<h2 class="heading-rule mb-12 text-center text-[2.3rem] font-semibold text-brand">
			{heading}
		</h2>
		<div class="grid gap-x-[1.5%] gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				services.map((s) => (
					<a
						href={s.href}
						class="group block overflow-hidden bg-white text-black shadow-[0_3px_10px_rgba(224,230,236,0.6)] transition-shadow hover:shadow-[0_7px_30px_0_rgba(204,209,214,0.95)]"
					>
						{s.cardImage && (
							<Image
								src={s.cardImage}
								alt=""
								widths={[320, 480, 640]}
								sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
								class="h-52 w-full object-cover"
							/>
						)}
						<h3 class="px-8 pt-8 font-semibold">{s.heading}</h3>
						<p class="px-8 pt-3 pb-8 text-[0.95rem] font-light leading-snug">{s.text}</p>
					</a>
				))
			}
		</div>
	</Container>
</section>
