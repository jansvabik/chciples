---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.svelte';
import Footer from '../components/Footer.astro';
import type { z } from 'astro/zod';
import type { seoSchema } from '../lib/schemas';
import type { JsonLdObject } from '../lib/jsonld';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
	title: string;
	seo?: z.input<typeof seoSchema>;
	jsonLd?: JsonLdObject[];
	ogImage?: string;
}

const { title, seo, jsonLd = [], ogImage: ogImageProp } = Astro.props;

const pageTitle = seo?.title ?? title;
const description = seo?.description ?? site.defaultDescription;
const canonical = seo?.canonical
	? new URL(seo.canonical, Astro.site).toString()
	: new URL(Astro.url.pathname, Astro.site).toString();
const ogType = seo?.og_type ?? 'website';
// Per-page generated OG image (see src/pages/og/[...path].png.ts); falls back
// to an explicit seo.og_image, then the shared static image.
const ogImageSrc = ogImageProp ?? seo?.og_image ?? '/images/og-image.jpg';
const ogImage = new URL(ogImageSrc, Astro.site).toString();
const currentPath = Astro.url.pathname;

const ldGraph =
	jsonLd.length > 0 ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }) : null;
---

<!doctype html>
<html lang="cs">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1.0" />
		<Font cssVariable="--font-montserrat" preload />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{seo?.robots && <meta name="robots" content={seo.robots} />}

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={site.locale} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-icon-180x180.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" />
		<link rel="manifest" href="/images/favicon/manifest.json" />
		<meta name="theme-color" content="#ffffff" />

		{ldGraph && <script type="application/ld+json" is:inline set:html={ldGraph} />}
		<ClientRouter />
	</head>
	<body>
		<Header {currentPath} client:idle />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
